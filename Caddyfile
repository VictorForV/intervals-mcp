# TLS terminator for the MCP server. Caddy obtains and renews HTTPS certificates.

{
	admin off
}

{$MCP_DOMAIN} {
	# Keep server-sent events flowing rather than buffering them.
	reverse_proxy mcp:8080 {
		flush_interval -1
	}

	log {
		# The secret token lives in the URL path, so request URIs are not logged.
		output stderr
		format filter {
			wrap console
			fields {
				request>uri delete
			}
		}
	}
}
